{
  "info": {
    "_postman_id": "unique-id",
    "name": "Movie Management API",
    "description": "API collection for Movie Management System with separate workflows for admin and regular users",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": [
            {
              "name": "Successful Login",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"token\": \"jwt.token.here\",\n  \"user\": {\n    \"id\": 1,\n    \"email\": \"user@example.com\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"roles\": [\"USER\"]\n  }\n}"
            }
          ]
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            }
          },
          "response": [
            {
              "name": "Successful Registration",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"token\": \"jwt.token.here\",\n  \"user\": {\n    \"id\": 1,\n    \"email\": \"newuser@example.com\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"roles\": [\"USER\"]\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "Get All Movies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/movies?page=0&size=10&sort=title,asc",
              "host": ["{{base_url}}"],
              "path": ["api", "movies"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "title,asc"
                }
              ]
            }
          }
        },
        {
          "name": "Get Movie by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/movies/{{movie_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "movies", "{{movie_id}}"]
            }
          }
        },
        {
          "name": "Create Movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/movies",
              "host": ["{{base_url}}"],
              "path": ["api", "movies"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Shawshank Redemption\",\n  \"description\": \"Two imprisoned men bond over a number of years...\",\n  \"releaseYear\": 1994,\n  \"genre\": \"Drama\",\n  \"director\": \"Frank Darabont\",\n  \"rating\": 9.3\n}"
            }
          }
        },
        {
          "name": "Update Movie",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/movies/{{movie_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "movies", "{{movie_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Movie Title\",\n  \"description\": \"Updated movie description\",\n  \"releaseYear\": 2023,\n  \"genre\": \"Action\",\n  \"director\": \"John Doe\",\n  \"rating\": 8.5\n}"
            }
          }
        },
        {
          "name": "Delete Movie",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/movies/{{movie_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "movies", "{{movie_id}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": "your-jwt-token-here"
    },
    {
      "key": "movie_id",
      "value": "1"
    }
  ]
}